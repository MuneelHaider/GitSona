<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitSona.App.ViewModels"
             xmlns:core="using:GitSona.Core"
             x:Class="GitSona.App.Views.RulesView"
             x:DataType="vm:RulesViewModel">

  <ScrollViewer>
    <StackPanel Spacing="14">
      <StackPanel>
        <TextBlock Text="Rules" Classes="h1" />
        <TextBlock Classes="muted" TextWrapping="Wrap"
                   Text="Rules pick the account automatically. Anything that matches no rule uses your default account." />
      </StackPanel>

      <Border Classes="banner info">
        <TextBlock TextWrapping="Wrap"
                   Text="If several rules match one repository, Git applies them from top to bottom and the LAST match wins. Put broad rules first and specific ones below them." />
      </Border>

      <Border Classes="card" IsVisible="{Binding IsEmpty}">
        <TextBlock Text="No rules yet. Add one below." Classes="muted" />
      </Border>

      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RuleItemViewModel">
            <Border Classes="card" Margin="0,0,0,8" Padding="12,10">
              <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                <TextBlock Grid.Column="0" Text="{Binding Position}" Classes="muted" VerticalAlignment="Center" MinWidth="26" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding AccountLabel}" Classes="ok" />
                    <TextBlock Text="wins when rules overlap" Classes="muted" FontSize="12" IsVisible="{Binding IsLast}" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                  <Button Content="▲" Command="{Binding MoveUpCommand}" IsEnabled="{Binding CanMoveUp}" ToolTip.Tip="Move up (applied earlier)" />
                  <Button Content="▼" Command="{Binding MoveDownCommand}" IsEnabled="{Binding CanMoveDown}" ToolTip.Tip="Move down (applied later, wins)" />
                  <Button Content="Delete" Command="{Binding DeleteCommand}" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Add a rule" Classes="h2" />
          <StackPanel Orientation="Horizontal" Spacing="16">
            <RadioButton GroupName="ruleType" Content="Folder" IsChecked="{Binding IsFolderRule}" />
            <RadioButton GroupName="ruleType" Content="Remote URL" IsChecked="{Binding IsRemoteRule}" IsEnabled="{Binding RemoteSupported}" />
          </StackPanel>
          <TextBlock Text="{Binding RemoteNote}" Classes="warn" TextWrapping="Wrap"
                     IsVisible="{Binding RemoteNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

          <StackPanel Spacing="4">
            <TextBlock Text="Use this account" Classes="muted" />
            <ComboBox ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" MinWidth="260">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="core:Account">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>

          <StackPanel Spacing="4" IsVisible="{Binding IsFolderRule}">
            <TextBlock Text="For every repository inside this folder" Classes="muted" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding FolderPath}" Watermark="C:\work or /home/me/work" />
              <Button Grid.Column="1" Content="Browse…" Command="{Binding BrowseCommand}" />
            </Grid>
          </StackPanel>

          <Grid ColumnDefinitions="*,*" ColumnSpacing="12" IsVisible="{Binding IsRemoteRule}">
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="Host" Classes="muted" />
              <TextBox Text="{Binding RemoteHost}" Watermark="https://gitlab.company.com" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Group or organisation (optional)" Classes="muted" />
              <TextBox Text="{Binding RemoteGroup}" Watermark="mycompany or mycompany/team" />
            </StackPanel>
          </Grid>

          <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Classes.error="{Binding StatusIsError}"
                     IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Button Content="Add rule" Classes="accent" Command="{Binding AddCommand}" HorizontalAlignment="Left" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
