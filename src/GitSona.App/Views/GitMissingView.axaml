<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitSona.App.ViewModels"
             x:Class="GitSona.App.Views.GitMissingView"
             x:DataType="vm:GitMissingViewModel">

  <StackPanel Spacing="16" MaxWidth="560" VerticalAlignment="Center" Margin="32">
    <TextBlock Text="Git is needed" Classes="h1" />
    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
    <TextBlock Classes="muted" TextWrapping="Wrap"
               Text="GitSona works through Git's own settings and credential system, so Git must be installed. Everything else is disabled until it is found." />
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Button Content="Download Git" Classes="accent" Command="{Binding DownloadCommand}" />
      <Button Content="I installed it — check again" Command="{Binding RecheckCommand}" />
    </StackPanel>
    <TextBlock Text="{Binding Status}" Classes="warn" TextWrapping="Wrap"
               IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
  </StackPanel>
</UserControl>
