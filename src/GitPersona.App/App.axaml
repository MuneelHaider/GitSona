<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitPersona.App.ViewModels"
             xmlns:views="using:GitPersona.App.Views"
             x:Class="GitPersona.App.App"
             RequestedThemeVariant="Default">

  <Application.DataTemplates>
    <DataTemplate DataType="vm:AccountsViewModel"><views:AccountsView /></DataTemplate>
    <DataTemplate DataType="vm:RulesViewModel"><views:RulesView /></DataTemplate>
    <DataTemplate DataType="vm:CheckerViewModel"><views:CheckerView /></DataTemplate>
    <DataTemplate DataType="vm:CloneViewModel"><views:CloneView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:FirstRunViewModel"><views:FirstRunView /></DataTemplate>
    <DataTemplate DataType="vm:GitMissingViewModel"><views:GitMissingView /></DataTemplate>
  </Application.DataTemplates>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
          <SolidColorBrush x:Key="GpWindowBackground">#F6F6F9</SolidColorBrush>
          <SolidColorBrush x:Key="GpSidebarBackground">#EAEAF0</SolidColorBrush>
          <SolidColorBrush x:Key="GpCardBackground">#FFFFFF</SolidColorBrush>
          <SolidColorBrush x:Key="GpCardBorder">#DEDEE6</SolidColorBrush>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="GpWindowBackground">#141418</SolidColorBrush>
          <SolidColorBrush x:Key="GpSidebarBackground">#1B1B21</SolidColorBrush>
          <SolidColorBrush x:Key="GpCardBackground">#202027</SolidColorBrush>
          <SolidColorBrush x:Key="GpCardBorder">#32323C</SolidColorBrush>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <Style Selector="TextBlock.h1">
      <Setter Property="FontSize" Value="24" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.h2">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Opacity" Value="0.68" />
    </Style>
    <Style Selector="TextBlock.ok"><Setter Property="Foreground" Value="#2E9E5B" /></Style>
    <Style Selector="TextBlock.info"><Setter Property="Foreground" Value="#3B82F6" /></Style>
    <Style Selector="TextBlock.warn"><Setter Property="Foreground" Value="#D98E04" /></Style>
    <Style Selector="TextBlock.error"><Setter Property="Foreground" Value="#E5484D" /></Style>

    <Style Selector="Border.card">
      <Setter Property="Background" Value="{DynamicResource GpCardBackground}" />
      <Setter Property="BorderBrush" Value="{DynamicResource GpCardBorder}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="16" />
    </Style>
    <Style Selector="Border.banner">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="Border.banner.warning"><Setter Property="Background" Value="#33D98E04" /></Style>
    <Style Selector="Border.banner.error"><Setter Property="Background" Value="#33E5484D" /></Style>
    <Style Selector="Border.banner.info"><Setter Property="Background" Value="#333B82F6" /></Style>
    <Style Selector="Border.badge">
      <Setter Property="Background" Value="#332E9E5B" />
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,2" />
    </Style>
    <Style Selector="Button.destructive">
      <Setter Property="Background" Value="#E5484D" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.destructive:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#C93A3F" />
      <Setter Property="TextElement.Foreground" Value="White" />
    </Style>
  </Application.Styles>
</Application>
