<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:GitPersona.App.ViewModels"
             x:Class="GitPersona.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <ScrollViewer>
    <StackPanel Spacing="14">
      <TextBlock Text="Settings" Classes="h1" />

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="General" Classes="h2" />
          <CheckBox Content="{Binding StartupLabel}" IsChecked="{Binding StartAtLogin}" IsEnabled="{Binding IsStartupAvailable}" />
          <TextBlock Text="{Binding StartupNote}" Classes="muted" FontSize="12"
                     IsVisible="{Binding StartupNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <TextBlock Text="Starts hidden in the tray. Off by default." Classes="muted" FontSize="12" />
          <TextBlock Text="{Binding Status}" Classes="error" TextWrapping="Wrap"
                     IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Git" Classes="h2" />
          <TextBlock Text="{Binding GitInfo}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding !IsInstalled}">
            <TextBlock Text="GitPersona is not active in your Git config." Classes="warn" VerticalAlignment="Center" />
            <Button Content="Turn on" Command="{Binding InstallCommand}" Classes="accent" />
          </StackPanel>
          <TextBlock Text="Credential helper" Classes="muted" Margin="0,6,0,0" />
          <TextBlock Text="{Binding HelperText}" TextWrapping="Wrap" />
          <Button Content="{Binding HelperFixLabel}" Command="{Binding FixHelperCommand}" IsVisible="{Binding HelperCanFix}" HorizontalAlignment="Left" />
          <TextBlock Text="Data folder" Classes="muted" Margin="0,6,0,0" />
          <DockPanel>
            <Button DockPanel.Dock="Right" Content="Open" Command="{Binding OpenDataFolderCommand}" Margin="10,0,0,0" VerticalAlignment="Top" />
            <TextBlock Text="{Binding DataFolder}" VerticalAlignment="Center" TextWrapping="Wrap" />
          </DockPanel>
          <TextBlock Text="Only account details (names, emails, hosts) are stored here. Tokens never are." Classes="muted" FontSize="12" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="About and updates" Classes="h2" />
          <TextBlock Text="{Binding Version, StringFormat='Version {0}'}" />
          <CheckBox Content="Check GitHub for updates once a day (installed version only)" IsChecked="{Binding AutoUpdate}" IsEnabled="{Binding UpdatesSupported}" />
          <TextBlock Text="{Binding UpdateNote}" Classes="muted" FontSize="12" TextWrapping="Wrap"
                     IsVisible="{Binding UpdateNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <StackPanel Orientation="Horizontal" Spacing="10" IsVisible="{Binding UpdatesSupported}">
            <Button Content="Check now" Command="{Binding CheckUpdatesCommand}" />
            <Button Content="Update and restart" Command="{Binding InstallUpdateCommand}" Classes="accent" IsVisible="{Binding UpdateReady}" />
            <TextBlock Text="{Binding UpdateStatus}" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Classes="muted" FontSize="12" TextWrapping="Wrap"
                     Text="Updating only ever happens when you click. This check is the only network request GitPersona makes besides checking tokens against your own Git host." />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Uninstall / restore" Classes="h2" />
          <TextBlock Text="{Binding BackupInfo}" TextWrapping="Wrap" Classes="muted" />
          <CheckBox Content="Restore the backup of my Git config from before GitPersona" IsChecked="{Binding RestoreBackup}" />
          <CheckBox Content="Also remove the logins GitPersona stored in my credential helper" IsChecked="{Binding RemoveLogins}" />
          <CheckBox Content="Also delete GitPersona's own data (accounts and rules)" IsChecked="{Binding DeleteData}" />
          <Button Content="Remove GitPersona from Git…" Command="{Binding UninstallCommand}" Classes="destructive" HorizontalAlignment="Left" />
          <TextBlock Text="{Binding UninstallStatus}" TextWrapping="Wrap"
                     IsVisible="{Binding UninstallStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
